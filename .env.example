# คัดลอกเป็น .env.local (dev) — ค่า production ตั้งใน Vercel ไม่ใส่ในไฟล์
# ยกเว้นตอนรัน migration/seed/import ใส่ prod จากเครื่อง: คัดลอกเป็น .env.prod.local แล้วใช้ ENV_FILE=.env.prod.local นำหน้าคำสั่ง
# วิธีหาค่า: docs/SETUP.md

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (ปุ่ม Connect → Connection String → URI → Transaction pooler) ---
# copy ทั้งบรรทัดจาก dashboard อย่าพิมพ์เอง · user ต้องเป็น postgres.<project ref> · host อาจเป็น aws-0 หรือ aws-1
# แทน [YOUR-PASSWORD] ด้วยรหัส database (ไม่มีวงเล็บ · ถ้ามี @ # % ต้อง URL-encode)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# migration/seed — ใช้ค่าเดียวกับ DATABASE_URL ได้ (session pooler port 5432 ของบางโปรเจกต์ต่อไม่ได้)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Sentry (ไม่ใส่ก็ได้ — dev ปกติไม่ต้องตั้ง) ---
# ตั้งบน production เพื่อให้ error ที่ไม่คาดถูกส่งไปแจ้งเตือน · DSN จาก Sentry → Project → Client Keys
SENTRY_DSN=
# เฉพาะตอน build บน Vercel ถ้าต้องการ source map (stack trace อ่านรู้เรื่อง): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
